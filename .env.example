# Copy to .env (git ignores it) and fill in. Never commit real values.
#
# DATABASE: Neon (https://neon.tech). Create a project, then open its "Connect" dialog.
#  - DATABASE_URL is the POOLED connection string (the host contains "-pooler").
#    The indexer and the API use it.
#  - DATABASE_URL_DIRECT is the DIRECT one (no "-pooler"). Only migrations use it.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# INDEXER
# A Starknet JSON-RPC endpoint. Devnet: http://127.0.0.1:5050/rpc. Sepolia: a provider's URL.
STARKNET_RPC_URL=http://127.0.0.1:5050/rpc
# Which deployment to index: sepolia, devnet or mainnet. The indexer reads the factory address and the
# block it was deployed in from contracts/deployments/<network>.json, which scripts/deploy.sh writes.
NETWORK=sepolia
# Only if you are NOT using NETWORK: point at a factory directly. START_BLOCK must then be the block the
# factory was deployed in; set later than that and launches are silently missed.
# FACTORY_ADDRESS=0x...
# START_BLOCK=0
# Optional extra RPC headers as JSON, if your provider wants an API key header
# STARKNET_RPC_HEADERS={"x-api-key":"..."}

# API
PORT=4000
# Browser origins allowed to call the API, comma-separated. Empty means none.
CORS_ORIGIN=http://localhost:3000
# Address to listen on. Default 127.0.0.1 (this machine only). Set 0.0.0.0 inside a container or behind a proxy.
# HOST=127.0.0.1
# How many proxies sit in front of the API (0 = none). Only then is the caller's address read from
# X-Forwarded-For. Setting this wrongly lets callers forge their address and dodge the rate limits.
# TRUST_PROXY_HOPS=0
# Requests each address may make per minute across the whole API.
# RATE_LIMIT_PER_MIN=300
# Most megabytes of token images kept in the database in total.
# MAX_IMAGE_STORAGE_MB=200
