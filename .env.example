# Copy to .env (git ignores it) and fill in. Never commit real values.
#
# DATABASE: Neon (https://neon.tech). Create a project, then open its "Connect" dialog.
#  - DATABASE_URL is the POOLED connection string (the host contains "-pooler").
#    The indexer and the API use it.
#  - DATABASE_URL_DIRECT is the DIRECT one (no "-pooler"). Only migrations use it.
DATABASE_URL=postgres://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgres://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# INDEXER
# A Starknet JSON-RPC endpoint. Devnet: http://127.0.0.1:5050/rpc. Sepolia: a provider's URL.
STARKNET_RPC_URL=http://127.0.0.1:5050/rpc
# The deployed TokenFactory (contracts/deployments/<network>.json -> factory.address)
FACTORY_ADDRESS=0x...
# First block to read. Set it to the block the factory was deployed in. Launches made before
# this block are never indexed.
START_BLOCK=0
# Optional extra RPC headers as JSON, if your provider wants an API key header
# STARKNET_RPC_HEADERS={"x-api-key":"..."}

# API
PORT=4000
# Browser origins allowed to call the API, comma-separated. Empty means none.
CORS_ORIGIN=http://localhost:3000
