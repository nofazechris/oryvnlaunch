# AI assistant. Put the key for ONE provider here, in apps/web/.env.local (never in this example file).
# Without any key the AI screens show plain prepared answers and say so.
#   Groq (free tier):   https://console.groq.com
#   Google Gemini:      https://aistudio.google.com   (free tier prompts can be used by Google to improve its products)
#   OpenRouter:         https://openrouter.ai         (free ":free" models)
#   Anthropic (paid):   https://console.anthropic.com
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Which provider to use if you set more than one key: groq, gemini, openrouter, anthropic or custom.
# AI_PROVIDER=groq
# Optional. Models to try, in order. A model that is rate limited falls through to the next one.
# AI_MODEL=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# Optional, for any other provider that speaks the chat-completions format (set AI_PROVIDER=custom and AI_MODEL).
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# Token pictures. The Launch Studio can draw a picture from a description. It works with NO setup: by default it
# uses Stable Horde, a free community network of volunteer GPUs (jobs queue, usually a few seconds). The creator's
# description is sent to that network, and the page tells them so.
#   AI_IMAGE_PROVIDER=horde | cloudflare | off      (off hides the picture maker entirely)
# AI_IMAGE_PROVIDER=horde
# Optional free key from https://stablehorde.net (registering moves you up the queue):
# STABLE_HORDE_API_KEY=
# Optional faster alternative: Cloudflare Workers AI (answers at once, has a free daily allowance). Both are secrets:
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Most pictures made per hour across the whole site (default 40).
# IMAGE_GLOBAL_PER_HOUR=40
# Most AI calls this site makes per hour in total, so nobody can use up your free allowance or run up a bill.
# AI_GLOBAL_PER_HOUR=600

# The read API (apps/api), and which Starknet network the app is on: devnet, sepolia or mainnet.
# NEXT_PUBLIC_ values are visible in the browser, so never put a secret in them.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_NETWORK=sepolia

# The deployed token factory (from contracts/deployments/<network>.json). Needed to launch tokens from the app.
NEXT_PUBLIC_FACTORY_ADDRESS=

# A Starknet RPC the browser can call (balances, trade previews, transaction status). Public: no secret keys.
# Devnet defaults to http://127.0.0.1:5050/rpc.
NEXT_PUBLIC_RPC_URL=
