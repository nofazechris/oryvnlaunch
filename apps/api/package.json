{
  "name": "@launchpad/api",
  "version": "0.1.0",
  "private": true,
  "description": "Read API for oryvnlaunch: launches, trades and market data from the indexed database",
  "type": "module",
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@launchpad/chain": "workspace:*",
    "@launchpad/db": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@nestjs/testing": "12.5.0",
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "5.1.0"
  }
}
