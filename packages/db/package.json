{
  "name": "@launchpad/db",
  "version": "0.1.0",
  "private": true,
  "description": "Postgres schema, migrations and typed access for oryvnlaunch. Runs on Neon in production.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/testing.ts --format esm --dts --clean --external @electric-sql/pglite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "db:check": "tsx --env-file-if-exists=../../.env src/check-cli.ts",
    "db:local": "node scripts/local-db.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "5.1.0"
  }
}
