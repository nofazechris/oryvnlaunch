{
  "name": "@launchpad/chain",
  "version": "0.1.0",
  "private": true,
  "description": "Starknet access for oryvnlaunch: JSON-RPC client and decoders for the factory and curve events",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsup": "9.0.0",
    "typescript": "5.7.2",
    "vitest": "5.1.0"
  }
}
