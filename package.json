{
  "name": "launchpad",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered Starknet token launchpad",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "test": "turbo run test",
    "db:check": "pnpm --filter @launchpad/db db:check",
    "db:migrate": "pnpm --filter @launchpad/db db:migrate",
    "db:local": "pnpm --filter @launchpad/db db:local",
    "preflight": "pnpm --filter @launchpad/chain build && node --env-file-if-exists=.env packages/chain/scripts/preflight.mjs"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
